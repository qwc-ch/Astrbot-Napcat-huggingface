# ============================================================
# 运行开关配置
# 修改后推送到 HF 仓库会自动重新构建并生效
# 取值必须为 true 或 false
# ============================================================

# 是否启动 NapCat（QQ 接入端）
ENABLE_NAPCAT=false

# 是否推送备份到 GitHub 仓库
# （关闭后仅保存容器内本地仓库，远端数据不再更新）
ENABLE_GIT_PUSH=false

# 是否推送大文件到 HF LFS 仓库
# （关闭后不扫描/上传大文件，但启动恢复不受影响）
ENABLE_HF_PUSH=true