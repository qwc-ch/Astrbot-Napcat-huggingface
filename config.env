# ============================================================
# 运行开关配置
# 修改后推送到 HF 仓库会自动重新构建并生效
# 取值必须为 true 或 false
# ============================================================

# 是否启动 NapCat（QQ 接入端）
ENABLE_NAPCAT=true

# git 元数据远端：github=GitHub 仓库，hf=HF 仓库（所有数据都放 HF）
GIT_BACKEND=github

# 元数据仓库（仅 GIT_BACKEND=hf 时生效，默认与 HF_REPO 相同）
# GIT_HF_REPO=yourname/astrbot-backup-lfs

# 是否推送备份到远端 git 仓库
# （关闭后仅保存容器内本地仓库，重启后数据会丢失）
ENABLE_GIT_PUSH=true

# 是否推送大文件到远端 LFS 仓库
# （关闭后不扫描/上传大文件，但启动恢复不受影响）
ENABLE_HF_PUSH=true